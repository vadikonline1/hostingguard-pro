# =============================================================================
# HOSTING AUTOMATION CONFIGURATION
# =============================================================================


# === CLOUDFLARE CONFIGURATION ===
# Copiaza acest fisier si completeaza cu valorile tale.
# NU comite valori reale in git — foloseste "change-me" ca placeholder.
FASTPANEL_PASSWORD="change-me"
TELEGRAM_BOT_TOKEN="change-me"
TELEGRAM_CHAT_ID="change-me"
TELEGRAM_THREAD_ID="change-me"


# === PATHS & DIRECTORIES ===
BOUNCER_DIR="/etc/automation-web-hosting"
SCRIPT_DIR="$BOUNCER_DIR/scripts"
SETUP_DIR="$BOUNCER_DIR/setup"
LOG_DIR="$BOUNCER_DIR/log"
SERVICE_DIR="/etc/systemd/system"

# === WHITELIST (IP-urile astea NU sunt blocate niciodata) ===
# Pune aici IP-ul tau de admin / birou / monitorizare, despartite prin spatiu.
# Guard-ul pune ACCEPT pe pozitia 1 in iptables (inaintea lanturilor f2b-*),
# le scoate din jailuri + threat-intel si le adauga in fail2ban ignoreip.
WHITELIST_IPS="change-me"

# === FAIL2BAN BACKEND ===
# 1 = ipset (1 regula hash in loc de sute liniare — mult mai rapid).
# Setup-ul testeaza automat suportul kernel; daca lipseste, revine la iptables-multiport.
USE_IPSET="1"

# === SCRIPTS ===
NOTIFY_SCRIPT="$BOUNCER_DIR/telegram_notify.sh"
REALTIME_SCRIPT="$SCRIPT_DIR/realtime-scan.sh"
DAILY_SCAN_SCRIPT="$SCRIPT_DIR/daily-scan.sh"
FULL_SCAN_SCRIPT="$SCRIPT_DIR/full-scan.sh"

# === FILE MONITORING-SCAN CONFIGURATION ===
QUARANTINE_DIR="/var/quarantine"
# ATENTIE: nu scana baze de date, mail spool, cache Docker/muzica — blocheaza IO + corupe date
EXCLUDE_PATHS="*.log *.tmp *.cache *.swp *.swx *.pid *.sock /var/lib/clamav/* $QUARANTINE_DIR/*"
# Realtime: doar web + upload/tmp — NU /var/backups integral (prea mare la inotify)
REALTIME_SCAN_PATHS="/var/www /etc/nginx /etc/apache2 /tmp /var/tmp"
# Daily: doar zone cu risc (web + home + tmp) — NU tot /var (include mysql, lib, spool)
DAILY_SCAN_PATHS="/var/www /home /tmp /var/tmp /etc/nginx /etc/apache2"
# Full: lunar, fara /usr, /proc, /sys, /dev, /run, /var/lib/{mysql,docker,clamav}
FULL_SCAN_PATHS="/var/www /home /root /etc /opt /tmp /var/tmp"
MAX_FILE_SIZE="25M"
MAX_SCANSIZE="50M"

# === RESOURCE GUARDS (anti-blocare VPS) ===
# Prioritate minima IO/CPU pentru toate scanarile
SCAN_NICE="19"
SCAN_IONICE_CLASS="3"
# Sari peste scan daca loadavg-1min > nrCPU * factor (default 2.0). 0 = dezactivat
MAX_LOAD_FACTOR="2.0"
# Timeouturi dure — opresc scanarile scapate de sub control
DAILY_CLAMAV_TIMEOUT="2700"
FULL_CLAMAV_TIMEOUT="5400"
MALDET_TIMEOUT_DAILY="1800"
MALDET_TIMEOUT_FULL="5400"
# Foloseste daemonul clamdscan (mult mai usor) cand e disponibil: 1/0
CLAM_USE_DAEMON="1"
# maldet si rkhunter sunt grele — dezactiveaza pe VPS mic (1-2GB RAM): 1/0
ENABLE_MALDET="1"
ENABLE_RKHUNTER="0"
# Carantina doar pentru fisiere web; fisierele sistem doar raportate (evita stricarea OS)
QUARANTINE_MODE="safe"
# Realtime: max scanari paralele + cooldown per fisier (sec)
REALTIME_MAX_PARALLEL="2"
REALTIME_COOLDOWN="120"
# Notificari: max mesaje/ora per tip (anti-spam Telegram care tine cronul blocat)
TELEGRAM_MAX_PER_HOUR="20"
# Autoheal praguri
DISK_CRIT="90"
MEM_CRIT="92"
LOAD_CRIT_FACTOR="3.0"

# === RETENTION (anti-HDD-plin) ===
# Loguri: 7 zile (logrotate zilnic + prune zilnic 01:15 ca plasa de siguranta)
LOG_RETENTION_DAYS="7"
# Carantina: 30 zile
QUARANTINE_RETENTION_DAYS="30"
